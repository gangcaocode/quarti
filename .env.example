# Copy to apps/mobile/.env and fill in from Supabase → Project Settings → API.
# Only the publishable (anon) key goes here: it is safe in the app because row-level security protects the data.
# Never put the secret / service_role key in the app or in git.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
